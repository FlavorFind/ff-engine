# Flavor Find Engine - Configuration Example
# Database connection moved to SSH server mayday@100.96.139.83
# CSV seed data is the authoritative source (575 dishes, 98 ingredients, 3361 mappings)

SECRET_KEY=local-debug-secret-key-not-for-production-1234567890
DJANGO_SETTINGS_MODULE=config.settings.dev
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database - CSV seed data is primary; PostgreSQL connection for SSH server
# To use PostgreSQL on the server, configure DATABASE_URL after DB access is verified:
# DATABASE_URL=postgresql://user:password@100.96.139.83:5433/flavorfind_engine_db
# For now, system uses CSV data from data/seeds/

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
SENTRY_DSN=
ENGINE_VERSION=1.0.0
DATASET_VERSION=1.0.0

# CSV Data Reference
CSV_DATA_PATH=data/seeds/
TOTAL_DISHES=575
TOTAL_INGREDIENTS=98
TOTAL_MAPPINGS=3361
